[Unit]
Description=Infra deployment agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/infra
Environment=OPENBAO_ADDR={{ vault_addr }}
{% if infra_allow_insecure_http | default(false) %}
Environment=INFRA_ALLOW_INSECURE_HTTP=true
{% endif %}
ExecStart=/home/prod/.bun/bin/bun run /opt/infra/server/main.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=/opt/infra /srv/projects /etc/caddy/sites-enabled /home/prod/.ssh /home/prod/.config/infra

[Install]
WantedBy=default.target
