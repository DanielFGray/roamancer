[Unit]
Description=Infra deployment agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/infra
Environment=OPENBAO_ADDR={{ vault_addr }}
Environment=INFRA_SERVICES_DIR=/opt/infra/services
{# The agent runs host-to-host operations (git clone, rsync) against other
   nodes' dlab_fqdn using its own deployed ~/.ssh/config -- but SshClient
   always passes an explicit `-p` flag, which overrides that config's Port
   directive. Without this map it falls back to 22 (correct in production,
   wrong in testground where nodes use non-standard ports). #}
{# systemd's Environment= splits unquoted values on whitespace -- to_json's
   default separators include spaces after ':' and ',', so the value must be
   single-quoted (JSON itself only uses double quotes, so this doesn't clash). #}
Environment=INFRA_SSH_PORT_MAP='{{ dict(groups['all'] | map('extract', hostvars, 'dlab_fqdn') | zip(groups['all'] | map('extract', hostvars, 'ansible_port') | map('default', 22))) | to_json }}'
{% if infra_allow_insecure_http | default(false) %}
Environment=INFRA_ALLOW_INSECURE_HTTP=true
{% endif %}
ExecStart=/home/prod/.bun/bin/bun run /opt/infra/server/main.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=/opt/infra /srv/projects /etc/caddy/sites-enabled /home/prod/.ssh /home/prod/.config/infra

[Install]
WantedBy=default.target
