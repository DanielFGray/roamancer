datacenter = "dlab"
node_name = "{{ inventory_hostname }}"
data_dir = "/opt/consul/data"
bind_addr = "{{ dlab_ip }}"
advertise_addr = "{{ dlab_ip }}"
client_addr = "0.0.0.0"
enable_local_script_checks = true

ports {
  server = 8300
  serf_lan = 8301
  http = 8500
  dns = 8600
}

{% if inventory_hostname in groups['obs'] %}
server = true
bootstrap_expect = 1
{% else %}
server = false
retry_join = ["{{ obs_addr }}"]
{% endif %}
