datacenter = "{{ nomad_datacenter }}"
region     = "{{ nomad_region }}"
data_dir   = "/opt/nomad/data"
bind_addr  = "{{ ansible_host }}"

{% if nomad_server %}
server {
  enabled          = true
  bootstrap_expect = 1
}
{% endif %}

client {
  enabled    = true
  node_class = "{{ nomad_node_class }}"

{% if nomad_node_class == "web" %}
  host_volume "postgres-data" {
    path      = "/opt/nomad/volumes/postgres"
    read_only = false
  }

  host_volume "valkey-data" {
    path      = "/opt/nomad/volumes/valkey"
    read_only = false
  }

  host_volume "registry-data" {
    path      = "/opt/nomad/volumes/registry"
    read_only = false
  }
{% endif %}

{% if nomad_node_class == "obs" %}
  host_volume "clickhouse-data" {
    path      = "/opt/nomad/volumes/clickhouse"
    read_only = false
  }

  host_volume "signoz-data" {
    path      = "/opt/nomad/volumes/signoz"
    read_only = false
  }

  host_volume "zookeeper-data" {
    path      = "/opt/nomad/volumes/zookeeper"
    read_only = false
  }
{% endif %}
}

consul {
  address = "127.0.0.1:8500"
}

vault {
  enabled = true
  address = "{{ vault_addr }}"
}

plugin "docker" {
  config {
    volumes {
      enabled = true
    }
  }
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}
