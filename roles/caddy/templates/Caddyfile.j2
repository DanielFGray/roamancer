# Reusable snippets

(static) {
	root * {args[0]}
	try_files {path} /index.html
	file_server
}

(otel_cors) {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "content-type, x-requested-with"
		header Access-Control-Max-Age "3600"
		respond 204
	}
	header Access-Control-Allow-Origin "{http.request.header.Origin}"
	header Access-Control-Allow-Methods "GET, POST, OPTIONS"
	header Access-Control-Allow-Headers "content-type, x-requested-with"
	header Access-Control-Max-Age "3600"
}

# ─── Static sites ───────────────────────────────────────────

danielfgray.com {
	import static /srv/www/danielfgray.com
}

www.danielfgray.com {
	redir https://danielfgray.com{uri} permanent
}

dfg.rocks {
	handle /drumdrive {
		redir https://drive.google.com/folderview?id=1zz_6dYuiLLK2Lxo7nULuiVcY9a_nWck4 temporary
	}
	handle {
		import static /srv/www/dfg.rocks
	}
}

dfg.codes {
	header Cross-Origin-Opener-Policy "same-origin"

	handle /node-preview* {
		header Cross-Origin-Embedder-Policy "require-corp"
		import static /srv/www/dfg.codes
	}
	handle {
		header Cross-Origin-Embedder-Policy "credentialless"
		import static /srv/www/dfg.codes
	}
}

eddie.dfg.rocks {
	import static /srv/www/eddie.dfg.rocks
}

# ─── Doc subdomains on dfg.codes ────────────────────────────

pg-sourcerer.dfg.codes {
	import static /srv/www/pg-sourcerer.dfg.codes
}

# Uncomment as doc sites are ready:
# pg-introspection.dfg.codes {
# 	import static /srv/www/pg-introspection.dfg.codes
# }

# ─── Proxied services ──────────────────────────────────────

postgres.garden {
	header Cross-Origin-Embedder-Policy "credentialless"
	header Cross-Origin-Opener-Policy "same-origin"
	header Cross-Origin-Resource-Policy "cross-origin"

	# NOTE: rate limiting on /api /auth /webhooks requires caddy-ratelimit plugin
	# https://github.com/mholt/caddy-ratelimit
	reverse_proxy localhost:3000
}

signoz.dfg.codes {
	handle /v1/* {
		import otel_cors
		reverse_proxy {{ obs_addr }}:4318
	}
	handle {
		reverse_proxy {{ obs_addr }}:8080
	}
}

otel.dfg.codes {
	import otel_cors
	reverse_proxy {{ obs_addr }}:4318
}

# ─── Redirects ──────────────────────────────────────────────

git.dfg.codes {
	redir https://github.com/DanielFGray{uri} permanent
}

git.danielfgray.com {
	redir https://github.com/DanielFGray{uri} permanent
}

