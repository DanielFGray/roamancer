{# Absolute paths, not the ~/.ssh/... defaults: host-to-host operations that
   need this file (e.g. service move's rsync) run it from inside `podman
   unshare`, where the calling user's real UID maps to 0 in the namespace --
   ssh's own tilde expansion resolves via getpwuid(0) ("root"), not $HOME,
   so a bare "~/.ssh/..." default silently misses prod's own files. #}
{% for host in groups['all'] %}
Host {{ hostvars[host].dlab_fqdn }}
  HostName {{ hostvars[host].dlab_ip }}
  Port {{ hostvars[host].ansible_port | default(22) }}
  User prod
  IdentityFile /home/prod/.ssh/id_ed25519
  UserKnownHostsFile /home/prod/.ssh/known_hosts
  StrictHostKeyChecking accept-new
  UpdateHostKeys yes

{% endfor %}
