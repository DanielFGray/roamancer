{
  "name": "server-alchemy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy state.run.ts",
    "staged:plan": "./staged-host-runner.sh plan",
    "staged:deploy": "./staged-host-runner.sh deploy",
    "staged:destroy": "./staged-host-runner.sh destroy",
    "nix:deps": "./refresh-nix-deps.sh",
    "history": "node --import ./node_modules/alchemy/bin/register-oxc.js src/history.ts",
    "format": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/sql-pg": "4.0.6",
    "@effect/sql-sqlite-node": "4.0.6",
    "@redis/client": "^5.12.1",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "bun2nix": "2.1.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
