{
  "apiVersion": "server-ansible/v2",
  "name": "platform-ingress",
  "services": [
    {
      "name": "traefik",
      "image": "docker.io/library/traefik:v3.7.13",
      "hostPort": 18080,
      "containerPort": 18080,
      "healthCheck": { "type": "http", "path": "/ping" },
      "cpu": 250,
      "memoryMB": 256,
      "networkMode": "host",
      "placement": { "_tag": "Node", "name": "atheist" },
      "identity": { "env": true },
      "storage": { "volume": "traefik-acme", "mountPath": "/var/lib/traefik-acme" },
      "readOnlyMounts": [
        { "volume": "traefik-routes", "mountPath": "/var/lib/traefik-routes" },
        { "volume": "nix-store", "mountPath": "/nix/store" }
      ],
      "environment": [],
      "connections": [],
      "secrets": [
        {
          "_tag": "KvSecret",
          "path": "secret/data/platform/ingress",
          "key": "cloudflare_dns_api_token",
          "env": "CF_DNS_API_TOKEN"
        }
      ],
      "args": [
        "--global.checknewversion=false",
        "--global.sendanonymoususage=false",
        "--log.level=ERROR",
        "--entrypoints.web.address=:443",
        "--entrypoints.web.http.tls.certresolver=letsencrypt",
        "--entrypoints.http.address=:80",
        "--entrypoints.http.http.redirections.entrypoint.to=web",
        "--entrypoints.http.http.redirections.entrypoint.scheme=https",
        "--entrypoints.health.address=:18080",
        "--ping.entrypoint=health",
        "--certificatesresolvers.letsencrypt.acme.storage=/var/lib/traefik-acme/acme.json",
        "--certificatesresolvers.letsencrypt.acme.tlschallenge=true",
        "--certificatesresolvers.cloudflare.acme.storage=/var/lib/traefik-acme/cloudflare.json",
        "--certificatesresolvers.cloudflare.acme.dnschallenge.provider=cloudflare",
        "--providers.nomad=true",
        "--providers.nomad.endpoint.address=http://127.0.0.1:4646",
        "--providers.nomad.exposedbydefault=false",
        "--providers.nomad.refreshinterval=5s",
        "--providers.file.directory=/var/lib/traefik-routes",
        "--providers.file.watch=true"
      ]
    }
  ]
}
