#!/bin/sh
# Operates the platform from this machine, on the control host:
#   ops release [folder]          build, push and deploy the app repository's current commit
#   ops stage [folder]            deploy the current commit as a staged instance
#   ops promote [folder]          deploy the staged commit live, then discard the stage
#   ops discard giglist           destroy a staged instance
#   ops deployment list giglist   the recorded deployments of an app, newest first
#   ops rollback giglist 12       deploy recorded deployment 12 again
#   ops deploy --stage platform-data   Alchemy deploy of a platform cartridge
#   ops deploy --stage giglist    deploy an app's newest recorded deployment again
#   ops logs giglist-worker --tail     a job's logs, or why it is not running
#   ops secret set github_client_secret   store a key the cartridge in the current directory reads
#   ops secret list                       which referenced keys are set; never prints values
#   ops dash                      every job's health and each node's load, once
#   ops status giglist
#   ops rebuild [host]            sync nixos/ to a host and switch it to that config (default every host)
#   ops install [--yes] host target   erase a machine's disk and install a host's configuration
#   ops --help
# An app's cartridge lives in its own repository (folder defaults to the current
# directory); release sends it to the control host with its images pinned, and the host
# records it. Set CARTRIDGE to a cartridge file to send one with any host command.
# The workstation commands (release, stage, promote, discard, secret) run here and reach the
# host only for what they need there.
# The control host runs the Nomad server, OpenBao and the Alchemy state. It is
# `cluster.server` in the site.toml that OPS_SITE names (the folder that holds your
# installation's facts; nixos/site is the placeholder one). Set OPS_HOST to reach a
# different one. Each host command first syncs tools/alchemy to
# ~/alchemy there, so it runs the platform cartridges and code in this checkout.
# The host's Alchemy state and node_modules stay.
set -eu
# The real folder, also when ops is run through a link on PATH.
here=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
# One string from the site.toml in OPS_SITE, by dotted key such as cluster.server.
site_value() {
  if [ -z "${OPS_SITE:-}" ]; then
    echo "ops: set OPS_SITE to the folder that holds your site.toml" >&2
    exit 2
  fi
  bun -e 'let v = (await import(process.argv[1])).default
for (const key of process.argv[2].split(".")) v = v?.[key]
if (typeof v !== "string") {
  console.error(`${process.argv[2]} is not set in ${process.argv[1]}`)
  process.exit(1)
}
console.log(v)' "$OPS_SITE/site.toml" "$1"
}
nixos=$(cd "$here/../../nixos" && pwd)
# Sets $site to the OPS_SITE folder; $1 names the command for the error.
use_site() {
  [ -n "${OPS_SITE:-}" ] || { echo "ops $1: set OPS_SITE to the folder that holds your site.toml" >&2; exit 2; }
  site=$(cd "$OPS_SITE" && pwd)
}
# A host is a nixosConfigurations name in nixos/flake.nix; $2 names the command for the error.
check_host_name() {
  case $1 in
    *[!a-z0-9-]* | "")
      echo "ops $2: '$1' is not a flake host name" >&2
      exit 2
      ;;
  esac
}
# Copies the nixos folder to $1, a path or host:path, with the site folder as its `site`
# folder. nixos/site holds placeholder values; the build must see this installation's.
copy_nixos() {
  rsync -a --delete --exclude result --exclude /site "$nixos/" "$1/"
  rsync -a --delete --exclude .git "$site/" "$1/site/"
}
# Building and pushing need the workstation's Docker and registry certificate, and the
# secret commands read the cartridge from the workstation's folder.
case "${1:-}" in
  --help | -h)
    printf '%s\n' \
      'Usage: ops <command> [arguments]' \
      '  release [folder]          build, push and deploy an app repository'"'"'s commit' \
      '  stage [folder]            deploy the commit as a tailnet-only stage' \
      '  promote [folder]          release the staged commit live, then discard it' \
      '  discard <name>            destroy the staged instance' \
      '  rollback <name> <id>      deploy a recorded deployment again' \
      '  deployment list <name>    list recorded deployments' \
      '  deploy|plan|destroy ...   run Alchemy on the control host' \
      '  secret set|list|check     the OpenBao secrets that ./cartridge.json reads' \
      '  dash                      every job'\''s health and each node'\''s load' \
      '  place-queued              ask Nomad to place queued jobs again (rebuild runs it)' \
      '  status|logs ...           inspect Nomad' \
      '  rebuild [host]            sync nixos/ to the host and switch it (default every host)' \
      '  install [--yes] <host> <target>  erase the target'"'"'s disk and install the host'"'"'s configuration' \
      'Set OPS_HOST to select the control host, CARTRIDGE to send a cartridge file.'
    exit 0
    ;;
  release | stage | promote | discard | secret)
    OPS_HOST=${OPS_HOST:-$(site_value cluster.server)}
    export OPS_HOST
    command=$1
    shift
    exec bun "$here/src/release.ts" "$command" "$@"
    ;;
  rebuild)
    # Host config, not apps: copy the repo's nixos folder to each host's /etc/nixos, then
    # build and activate it there, so the host's own Nix builds it. sudo asks for the
    # password on the terminal, so hosts go one at a time; the first failure stops the run.
    # A host is a nixosConfigurations name in nixos/flake.nix; without one, every host.
    # The ssh target is that name, so ~/.ssh/config supplies the address and user.
    use_site rebuild
    if [ $# -ge 2 ]; then
      hosts=$2
    else
      hosts=$(sed -n 's/^ *nixosConfigurations\.\([a-z0-9-]*\) *=.*/\1/p' "$nixos/flake.nix")
    fi
    for flake_host in $hosts; do
      check_host_name "$flake_host" rebuild
      target=${3:-$flake_host}
      echo "== $flake_host ($target)" >&2
      # A freshly installed host has no /etc/nixos until its first rebuild declares one.
      ssh "$target" test -w /etc/nixos || ssh -t "$target" 'sudo install -d -o "$(id -un)" -g root -m 0755 /etc/nixos'
      # The copy replaces /etc/nixos. A change made by hand on the host is lost by the
      # switch, and a rollback needs the source it was built from, so keep what was there.
      ssh "$target" "rsync -a --delete /etc/nixos/ /var/tmp/nixos-before-rebuild/"
      copy_nixos "$target:/etc/nixos"
      ssh -t "$target" "sudo nixos-rebuild switch --flake 'path:/etc/nixos#$flake_host'"
    done
    # A switch can add the host volume or memory a queued job waits for; Nomad does not
    # retry on its own.
    exec "$0" place-queued
    ;;
  install)
    # Erases a machine's disk and installs a host's configuration with nixos-anywhere, for a
    # machine that does not run NixOS yet (a running one takes `rebuild`). The workstation has
    # no Nix, so the build runs in the nixos/nix container. Its store lives in a named volume
    # bound to ~/.cache, not Docker's data root, because a system closure fills a small root
    # disk; Docker seeds the empty volume from the image on first use.
    #
    # Files under ~/.local/state/server-ansible/extra-files/<host> (SSH host keys, Tailscale
    # state, and for a cluster node its CA certificates and password hash) are copied onto the
    # new root, so the host keeps its identity across the reinstall. The host's config sets the
    # owners and modes of the files it reads; this sets only those of /etc/ssh and Tailscale.
    # Folder modes are copied too: sshd reads authorized_keys.d as the user, so etc/ssh must be 0755.
    shift
    confirmed=no
    if [ "${1:-}" = --yes ]; then
      confirmed=yes
      shift
    fi
    flake_host=${1:?ops install: name a host, such as cynic}
    target=${2:?ops install: name the ssh target, such as operator@192.168.50.10}
    shift 2
    check_host_name "$flake_host" install
    use_site install
    if [ "$confirmed" != yes ]; then
      [ -t 0 ] || { echo "ops install: pass --yes to erase $target without a terminal" >&2; exit 2; }
      printf 'This erases the disk of %s. Type the host name (%s) to continue: ' "$target" "$flake_host" >&2
      read -r answer
      [ "$answer" = "$flake_host" ] || { echo "ops install: not confirmed" >&2; exit 1; }
    fi
    extra=$HOME/.local/state/server-ansible/extra-files/$flake_host
    if [ -d "$extra" ]; then
      set -- --extra-files /extra --chown /etc/ssh 0:0 --chown /var/lib/tailscale 0:0 "$@"
    else
      extra=
    fi
    if ! docker volume inspect server-ansible-nix >/dev/null 2>&1; then
      mkdir -p -- "$HOME/.cache/server-ansible-nix"
      docker volume create --opt type=none --opt o=bind --opt device="$HOME/.cache/server-ansible-nix" server-ansible-nix >/dev/null
    fi
    tree=$(mktemp -d)
    trap 'rm -rf "$tree"' EXIT
    copy_nixos "$tree"
    docker run --rm --network host \
      --volume server-ansible-nix:/nix \
      --volume "$tree:/src:ro" \
      --volume "${SSH_KEY:-$HOME/.ssh/id_ed25519}:/key:ro" \
      ${extra:+--volume} ${extra:+"$extra:/extra:ro"} \
      --env NIX_CONFIG="experimental-features = nix-command flakes" \
      nixos/nix:latest sh -euc '
        install -d -m700 /root/.ssh && install -m600 /key /root/.ssh/id
        printf "Host *\n  IdentityFile /root/.ssh/id\n  StrictHostKeyChecking accept-new\n" > /root/.ssh/config
        cp -r /src /work
        host=$1 target=$2
        shift 2
        exec nix run "$0" -- --flake "path:/work#$host" --target-host "$target" "$@"
      ' github:nix-community/nixos-anywhere/1.11.0 "$flake_host" "$target" "$@"
    exit 0
    ;;
esac
host=${OPS_HOST:-$(site_value cluster.server)}
# --delete, so a file removed here cannot linger on the host; the excluded folders hold
# the host's own state and are kept.
rsync -a --delete --exclude node_modules --exclude .alchemy --exclude logs "$here/" "$host:alchemy/"
# Quote one value for the remote shell.
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
quoted=""
for arg in "$@"; do quoted="$quoted $(q "$arg")"; done
environment=""
if [ "${CARTRIDGE+x}" = x ]; then
  # Under .alchemy, which the sync above keeps, and named per run.
  sent=".alchemy/input/cartridge-$(date +%s)-$$.json"
  ssh "$host" "mkdir -p alchemy/.alchemy/input"
  scp -q "$CARTRIDGE" "$host:alchemy/$sent"
  environment=" $(q "CARTRIDGE_FILE=$sent")"
fi
# A release sends the repository and commit the host records; a staged deploy sends its image.
for name in ORIGIN REVISION STAGED_IMAGE; do
  eval "given=\${$name+x}"
  if [ "$given" = x ]; then environment="$environment $(q "$name=$(eval "printf %s \"\$$name\"")")"; fi
done
remote="alchemy/scripts/ops-on-host.sh$quoted"
if [ -n "$environment" ]; then remote="env$environment $remote"; fi
# The remote shell starts in the home folder. A terminal is asked for only when this
# one has one: prompts such as `ops login` need it, and piped output does not.
if [ -t 0 ]; then exec ssh -t "$host" "$remote"; fi
exec ssh "$host" "$remote"
