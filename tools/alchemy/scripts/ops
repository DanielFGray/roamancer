#!/bin/sh
# Operates the platform from this machine, on the control host:
#   ops release [folder]          build, push and deploy the app repository's current commit
#   ops stage [folder]            deploy the current commit as a staged instance
#   ops promote [folder]          deploy the staged commit live, then discard the stage
#   ops discard giglist           destroy a staged instance
#   ops deployment list giglist   the recorded deployments of an app, newest first
#   ops rollback giglist 12       deploy recorded deployment 12 again
#   ops deploy --stage platform-data   Alchemy deploy of a platform cartridge
#   ops deploy --stage giglist    deploy an app's newest recorded deployment again
#   ops logs giglist-worker --tail     a job's logs, or why it is not running
#   ops secret set github_client_secret   store a key the cartridge in the current directory reads
#   ops secret list                       which referenced keys are set; never prints values
#   ops dash                      every job's health and each node's load, once
#   ops status giglist
#   ops rebuild [host]            sync nixos/ to a host and switch it to that config (default every host)
#   ops --help
# An app's cartridge lives in its own repository (folder defaults to the current
# directory); release sends it to the control host with its images pinned, and the host
# records it. Set CARTRIDGE to a cartridge file to send one with any host command.
# The workstation commands (release, stage, promote, discard, secret) run here and reach the
# host only for what they need there.
# The control host runs the Nomad server, OpenBao and the Alchemy state; set
# OPS_HOST to reach a different one. Each host command first syncs tools/alchemy to
# ~/alchemy there, so it runs the platform cartridges and code in this checkout.
# The host's Alchemy state and node_modules stay.
set -eu
# The real folder, also when ops is run through a link on PATH.
here=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
# Building and pushing need the workstation's Docker and registry certificate, and the
# secret commands read the cartridge from the workstation's folder.
case "${1:-}" in
  --help | -h)
    printf '%s\n' \
      'Usage: ops <command> [arguments]' \
      '  release [folder]          build, push and deploy an app repository'"'"'s commit' \
      '  stage [folder]            deploy the commit as a tailnet-only stage' \
      '  promote [folder]          release the staged commit live, then discard it' \
      '  discard <name>            destroy the staged instance' \
      '  rollback <name> <id>      deploy a recorded deployment again' \
      '  deployment list <name>    list recorded deployments' \
      '  deploy|plan|destroy ...   run Alchemy on the control host' \
      '  secret set|list|check     the OpenBao secrets that ./cartridge.json reads' \
      '  dash                      every job'\''s health and each node'\''s load' \
      '  status|logs ...           inspect Nomad' \
      '  rebuild [host]            sync nixos/ to the host and switch it (default every host)' \
      'Set OPS_HOST to select the control host, CARTRIDGE to send a cartridge file.'
    exit 0
    ;;
  release | stage | promote | discard | secret)
    command=$1
    shift
    exec bun "$here/src/release.ts" "$command" "$@"
    ;;
  rebuild)
    # Host config, not apps: copy the repo's nixos folder to each host's /etc/nixos, then
    # build and activate it there, so the host's own Nix builds it. sudo asks for the
    # password on the terminal, so hosts go one at a time; the first failure stops the run.
    # A host is a nixosConfigurations name in nixos/flake.nix; without one, every host.
    nixos=$(cd "$here/../../nixos" && pwd)
    if [ $# -ge 2 ]; then
      hosts=$2
    else
      hosts=$(sed -n 's/^ *nixosConfigurations\.\([a-z0-9-]*\) *=.*/\1/p' "$nixos/flake.nix")
    fi
    for flake_host in $hosts; do
      case $flake_host in
        *[!a-z0-9-]* | "")
          echo "ops rebuild: '$flake_host' is not a flake host name" >&2
          exit 2
          ;;
      esac
      target=${3:-$flake_host.dlab}
      echo "== $flake_host ($target)" >&2
      # A freshly installed host has no /etc/nixos until its first rebuild declares one.
      ssh "$target" test -w /etc/nixos || ssh -t "$target" sudo install -d -o dan -g root -m 0755 /etc/nixos
      # The copy replaces /etc/nixos. A change made by hand on the host is lost by the
      # switch, and a rollback needs the source it was built from, so keep what was there.
      ssh "$target" "rsync -a --delete /etc/nixos/ /var/tmp/nixos-before-rebuild/"
      rsync -a --delete --exclude result "$nixos/" "$target:/etc/nixos/"
      ssh -t "$target" "sudo nixos-rebuild switch --flake 'path:/etc/nixos#$flake_host'"
    done
    exit 0
    ;;
esac
host=${OPS_HOST:-cynic.dlab}
# --delete, so a file removed here cannot linger on the host; the excluded folders hold
# the host's own state and are kept.
rsync -a --delete --exclude node_modules --exclude .alchemy --exclude logs "$here/" "$host:alchemy/"
# Quote one value for the remote shell.
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }
quoted=""
for arg in "$@"; do quoted="$quoted $(q "$arg")"; done
environment=""
if [ "${CARTRIDGE+x}" = x ]; then
  # Under .alchemy, which the sync above keeps, and named per run.
  sent=".alchemy/input/cartridge-$(date +%s)-$$.json"
  ssh "$host" "mkdir -p alchemy/.alchemy/input"
  scp -q "$CARTRIDGE" "$host:alchemy/$sent"
  environment=" $(q "CARTRIDGE_FILE=$sent")"
fi
# A release sends the repository and commit the host records; a staged deploy sends its image.
for name in ORIGIN REVISION STAGED_IMAGE; do
  eval "given=\${$name+x}"
  if [ "$given" = x ]; then environment="$environment $(q "$name=$(eval "printf %s \"\$$name\"")")"; fi
done
remote="alchemy/scripts/ops-on-host.sh$quoted"
if [ -n "$environment" ]; then remote="env$environment $remote"; fi
# The remote shell starts in the home folder. A terminal is asked for only when this
# one has one: prompts such as `ops login` need it, and piped output does not.
if [ -t 0 ]; then exec ssh -t "$host" "$remote"; fi
exec ssh "$host" "$remote"
