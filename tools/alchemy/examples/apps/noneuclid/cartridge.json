{
  "apiVersion": "server-ansible/v2",
  "name": "noneuclid",
  "services": [
    {
      "name": "noneuclid",
      "image": "registry.cluster:5000/noneuclid-noneuclid@sha256:e7cba4b6214b1df5676f6eb660355d3a255fdef4675e943e28e8cfb5be14b058",
      "hostPort": "dynamic",
      "containerPort": 5181,
      "healthCheck": { "type": "tcp" },
      "cpu": 200,
      "memoryMB": 256,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["server.js"],
      "storage": { "volume": "noneuclid-data", "mountPath": "/data" },
      "routes": [{ "host": "game.example.test" }],
      "environment": [
        { "name": "PORT", "value": "5181" },
        { "name": "PLAY_DIR", "value": "/app/public" },
        { "name": "LEVELS_DIR", "value": "/app/seed/levels" },
        { "name": "TUNABLES_PATH", "value": "/app/seed/tunables.json" },
        { "name": "DB_PATH", "value": "/data/noneuclid.sqlite" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ],
      "connections": [],
      "secrets": []
    }
  ]
}
