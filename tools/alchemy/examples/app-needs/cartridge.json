{
  "apiVersion": "server-ansible/v2",
  "name": "app-needs",
  "postgres": [
    {
      "database": "app_needs"
    }
  ],
  "valkey": {},
  "services": [
    {
      "name": "app-needs",
      "image": "example/app-needs:latest",
      "hostPort": "dynamic",
      "containerPort": 8080,
      "cpu": 200,
      "memoryMB": 256,
      "networkMode": "bridge",
      "environment": [],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "app_needs",
          "login": "api",
          "usernameEnv": "PGUSER",
          "passwordEnv": "PGPASSWORD",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "ValkeyCredentials",
          "usernameEnv": "VALKEY_USER",
          "passwordEnv": "VALKEY_PASSWORD",
          "urlEnv": "VALKEY_URL"
        }
      ]
    }
  ]
}
