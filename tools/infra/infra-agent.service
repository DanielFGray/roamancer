[Unit]
Description=Infra deployment agent
After=network.target

[Service]
Type=simple
User=prod
ExecStart=/usr/local/bin/bun run /opt/infra/agent/server/main.ts
Restart=always
RestartSec=5
Environment=STATE_DB_PATH=/opt/infra/state.db
EnvironmentFile=-/opt/infra/.env

[Install]
WantedBy=multi-user.target
