# Disk layout for nixos-anywhere. Proxmox boots these VMs with SeaBIOS, so GRUB needs a
# BIOS boot partition on the GPT disk. Installing from this file erases the whole disk.
{ ... }:
{
  disko.devices.disk.main = {
    type = "disk";
    device = "/dev/sda";
    content = {
      type = "gpt";
      partitions = {
        boot = {
          size = "1M";
          type = "EF02";
        };
        swap = {
          size = "4G";
          content.type = "swap";
        };
        root = {
          size = "100%";
          content = {
            type = "filesystem";
            format = "ext4";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
